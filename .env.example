APP_NAME="Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated IPs, or "*" to trust the immediate proxy. Leave blank
# unless the host puts a reverse proxy/load balancer in front of the app.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production (Hostinger): use mysql with credentials from hPanel.
# For quick local dev, switch DB_CONNECTION to sqlite and comment the block below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payments — no gateway is integrated; orders are settled out of band
# (bank transfer / UPI) and confirmed by hand in the Accounts panel.
# Fill these in on the live server: buyers are shown exactly these
# details plus a reference to quote, and blank fields are omitted.
#
# QUOTE any value containing spaces. An unquoted space breaks dotenv
# parsing and takes the whole site down on boot, not just this feature.
PAYMENT_CURRENCY=USD
PAYMENT_CURRENCY_SYMBOL=$
PAYMENT_REFERENCE_PREFIX=AWK

PAYMENT_ACCOUNT_NAME="Your Company Ltd"
PAYMENT_BANK_NAME="Your Bank"
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_IFSC=
PAYMENT_SWIFT=
PAYMENT_UPI_ID=
PAYMENT_NOTES="Payments are confirmed within one business day."
